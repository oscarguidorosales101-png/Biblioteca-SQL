# Configuración de Entorno — Biblioteca-SQL (Fase 1 y preparación Fase 2)
# No ingresar contraseñas, secretos ni cadenas de conexión reales en este archivo.

# Modo de origen de datos: 'local' (localStorage en Fase 1) | 'http' (API REST en Fase 2)
VITE_DATA_SOURCE_MODE=local

# URL base de la futura API REST conectada a PostgreSQL (Fase 2)
VITE_API_URL=http://localhost:4000/api/v1
